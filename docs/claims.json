      "implementation": {
        "path": "climate_agent/workflow.py",
        "symbol": "human_review"
      },
      "tests": {
        "path": "tests/test_workflow.py",
        "symbols": [
          "test_human_attestation_required",
          "test_demo_cannot_be_approved",
