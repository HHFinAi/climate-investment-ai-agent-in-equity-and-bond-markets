        "path": "climate_agent/validation.py",
        "symbol": "validate_artifact"
      },
      "tests": {
        "path": "tests/test_validation.py",
        "symbols": [
          "test_unknown_evidence",
          "test_current_fact_unreviewed_rejected"
        ]
      },
      "boundary": "A valid reference and review flag do not prove source truth or citation support."
    },
    {
      "id": "IQ-02",
      "claim": "Facts, assumptions and calculations are distinguishable.",
      "implementation": {
        "path": "climate_agent/validation.py",
        "symbol": "validate_artifact"
      },
      "tests": {
        "path": "tests/test_validation.py",
        "symbols": [
          "test_no_fact_from_textbook_alone",
          "test_no_fact_from_assumption"
        ]
      },
      "boundary": "Checks use declared categories; semantic misclassification remains possible."
    },
    {
      "id": "IQ-03",
      "claim": "Current facts use explicit evidence-date and primary-policy rules.",
      "implementation": {
        "path": "climate_agent/validation.py",
        "symbol": "validate_artifact"
      },
      "tests": {
