      "boundary": "Frozen metadata is not automatic archival of source files or reproducible LLM output."
    },
    {
      "id": "IQ-05",
      "claim": "Revisions invalidate downstream conclusions and prior review.",
      "implementation": {
        "path": "climate_agent/workflow.py",
        "symbol": "submit"
      },
      "tests": {
