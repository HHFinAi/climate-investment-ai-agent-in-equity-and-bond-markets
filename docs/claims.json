    {
      "id": "IQ-07",
      "claim": "Equity, credit and labelled-debt research are routed separately.",
      "implementation": {
        "path": "climate_agent/workflow.py",
        "symbol": "select_nodes"
      },
      "tests": {
        "path": "tests/test_workflow.py",
        "symbols": [
          "test_labelled_sovereign_uses_sovereign_not_corporate_credit",
          "test_label_requires_additional_route"
        ]
      },
      "boundary": "Routing does not replace credit, legal or specialist structured-pricing diligence."
