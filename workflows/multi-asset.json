{
  "id": "multi-asset",
  "version": "0.1.0",
  "asset_classes": [
    "equity",
    "corporate_bond",
    "sovereign_bond",
    "municipal_bond",
    "structured_credit"
  ],
  "require_labelled": false,
  "nodes": [
    {
      "id": "mandate",
      "depends_on": []
    },
    {
      "id": "evidence",
      "depends_on": [
        "mandate"
      ]
    },
    {
      "id": "science-materiality",
      "depends_on": [
        "evidence"
      ]
    },
    {
      "id": "disclosure-policy",
      "depends_on": [
        "evidence"
      ]
    },
    {
      "id": "emissions",
      "depends_on": [
        "evidence"
      ]
    },
    {
      "id": "physical-risk",
      "depends_on": [
        "science-materiality"
      ]
    },
    {
      "id": "transition",
      "depends_on": [
        "science-materiality",
        "disclosure-policy",
        "emissions"
      ]
    },
    {
      "id": "scenarios",
      "depends_on": [
        "science-materiality",
        "disclosure-policy"
      ]
    },
    {
      "id": "financial-transmission",
      "depends_on": [
        "physical-risk",
        "transition",
        "scenarios"
      ]
    },
    {
      "id": "equity",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "equity"
    },
    {
      "id": "corporate-credit",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "corporate_bond"
    },
    {
      "id": "sovereign",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "sovereign_bond"
    },
    {
      "id": "municipal",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "municipal_bond"
    },
    {
      "id": "structured-credit",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "structured_credit"
    },
    {
      "id": "labelled-debt",
      "depends_on": [
        "financial-transmission"
      ],
      "when": "labelled"
    },
    {
      "id": "portfolio",
      "depends_on": [
        "equity",
        "corporate-credit",
        "sovereign",
        "municipal",
        "structured-credit",
        "labelled-debt"
      ]
    },
    {
      "id": "stewardship",
      "depends_on": [
        "portfolio"
      ]
    },
    {
      "id": "monitoring",
      "depends_on": [
        "portfolio"
      ]
    },
    {
      "id": "red-team",
      "depends_on": [
        "portfolio",
        "stewardship",
        "monitoring"
      ]
    },
    {
      "id": "investment-memo",
      "depends_on": [
        "red-team"
      ]
    }
  ],
  "human_review_required": true,
  "automatic_execution": false
}
