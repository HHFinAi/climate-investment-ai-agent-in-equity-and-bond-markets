{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence record",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "locator",
    "summary",
    "entity_scope",
    "as_of",
    "retrieved_on",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "entity_scope": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_on": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "issuer_disclosure",
        "market_data",
        "scenario_data",
        "policy_primary",
        "assumption",
        "synthetic",
        "methodology"
      ]
    },
    "review_status": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "SYNTHETIC"
      ]
    }
  }
}
