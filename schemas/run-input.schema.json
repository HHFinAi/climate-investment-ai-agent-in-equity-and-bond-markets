{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Climate workflow request",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "as_of",
    "mandate",
    "entities",
    "instruments",
    "evidence",
    "freshness_days"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "demo",
        "source_study",
        "research"
      ]
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "mandate": {
      "type": "object",
      "required": [
        "financial_objective",
        "climate_objective",
        "base_currency",
        "investment_horizon",
        "benchmark",
        "constraints"
      ],
      "properties": {
        "financial_objective": {
          "type": "string",
          "minLength": 1
        },
        "climate_objective": {
          "type": "string",
          "minLength": 1
        },
        "base_currency": {
          "type": "string",
          "minLength": 1
        },
        "investment_horizon": {
          "type": "string",
          "minLength": 1
        },
        "benchmark": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "corporate",
              "sovereign",
              "municipal",
              "spv"
            ]
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "issuer_id",
          "asset_class",
          "label",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "issuer_id": {
            "type": "string"
          },
          "asset_class": {
            "enum": [
              "equity",
              "corporate_bond",
              "sovereign_bond",
              "municipal_bond",
              "structured_credit"
            ]
          },
          "label": {
            "enum": [
              "none",
              "green",
              "sustainability",
              "sustainability_linked",
              "transition",
              "blue"
            ]
          },
          "currency": {
            "type": "string"
          }
        }
      }
    },
    "freshness_days": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "context": {
      "type": "object"
    }
  }
}
